generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  cik       String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  filings   Filing[]

  @@index([name])
}

model Filing {
  id                String      @id @default(cuid())
  institutionCik    String
  quarter           String
  filedAt           DateTime
  filingUrl         String
  isAmended         Boolean     @default(false)
  holdingsFetchedAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  institution       Institution @relation(fields: [institutionCik], references: [cik])
  holdings          Holding[]

  @@unique([institutionCik, quarter])
  @@index([institutionCik])
  @@index([quarter])
}

model Holding {
  id                    String     @id @default(cuid())
  filingId              String
  cusip                 String
  companyName           String
  rawShares             Int
  rawValue              Decimal    @db.Decimal(18, 2)
  cumulativeSplitFactor Decimal    @default(1.0)
  adjustedShares        Int
  priorAdjustedShares   Int?
  changeType            ChangeType @default(UNCHANGED)
  changePercent         Decimal?   @db.Decimal(8, 2)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  filing                Filing     @relation(fields: [filingId], references: [id])

  @@unique([filingId, cusip])
  @@index([cusip])
  @@index([filingId])
}

enum ChangeType {
  NEW
  EXITED
  INCREASED
  DECREASED
  UNCHANGED
}

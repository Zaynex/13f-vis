{
  "name": "sec-13f-visualizer",
  "version": "0.5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync": "./supabase/scripts/incremental-sync.sh",
    "db:sync:full": "./supabase/scripts/incremental-sync.sh full",
    "pipeline:run": "node --env-file=.env.local node_modules/.bin/tsx src/lib/pipeline/run.ts",
    "discover:institutions": "node --env-file=.env.local node_modules/.bin/tsx scripts/discover-institutions.ts",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:all": "vitest run tests",
    "test:fixtures": "vitest run src/lib/parser",
    "test:watch": "vitest tests"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/react-query": "^5.59.0",
    "cheerio": "^1.0.0",
    "next": "^16.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.1",
    "msw": "^2.12.13",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

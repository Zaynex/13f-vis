# Database — use any PostgreSQL connection string
# e.g. postgresql://user:password@localhost:5432/sec13f
DATABASE_URL="postgresql://user:password@localhost:5432/sec13f"

# Yahoo Finance — free API, no key required for basic stock split data
YAHOO_FINANCE_BASE_URL="https://query1.finance.yahoo.com"

# Polygon.io — free tier: 5 req/min, 500 req/day, 15min delayed stock split data
# Get your API key at https://polygon.io (free signup)
# Used as fallback when Yahoo Finance CUSIP→split lookup fails
POLYGON_API_KEY=""

# Supabase — for user authentication and personal watchlists/alerts
# Get your project URL and keys at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""